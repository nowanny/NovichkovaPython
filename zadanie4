def admission():
    необходимый_экзамен = {
        "Информатика": 80,
        "Математика": 85,
        "Русский язык": 75
    }
    
    print("""Для определения возможности поступления, необходима информация о
Вас.
Для ввода экзамена и баллов введите их через |: Химия | 40.
Для завершения ввода нажмите Enter.
""")
    
    сданные_экзамены = {}
    
    while True:
        ввод = input("").strip()
        if ввод == "":
            break
        
        try:
            экзамен, балл = [x.strip() for x in ввод.split("|")]
            балл = int(балл) 
            
            сданные_экзамены[экзамен] = балл
            
        except ValueError:
            print("Ошибка: Убедитесь, что вы ввели экзамен и баллы в правильном формате (например, 'Химия | 40').")
            continue
        except Exception as e:
            print(f"Произошла непредвиденная ошибка: {e}")
            continue

    print("Ваши экзамены:")
    for i, (экзамен, балл) in enumerate(сданные_экзамены.items(), start=1):
        print("{}) {} {}".format(i, экзамен, балл))

    ok = False
    for необходимый_экзамен, баллы in необходимые_экзамены.items():
        if необходимый_экзамен not in сданные_экзамены:
            print(f"Ошибка: Вы не сдали экзамен по {необходимый_экзамен}.")
            break
        if сданные_экзамены[необходимый_экзамен] < баллы:
            print(f"Ошибка: Баллы по {необходимый_экзамен} недостаточны. Требуется {баллы}, у вас {сданные_экзамены[необходимый_экзамен]}.")
            break
    else:
        ok = True
    
    print("Вы можете к нам поступить!" if ok else "Увы...")

if __name__ == "__main__":
    admission()
