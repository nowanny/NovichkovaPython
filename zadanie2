def power(x, y=2):

    if y < 0:
        raise ValueError("Степень y не должна быть отрицательной.")
    if y == 0:
        return 1
    else:
        return x * power(x, y - 1)

def main():
    try:
        x = int(input("x="))
        y = int(input("y="))
        res = power(x, y)
        print(f"{x} в степени {y} равно {res}")
    except ValueError as ve:
        print(f"Ошибка: {ve}")
    except TypeError:
        print("Ошибка: Ввод должен быть целым числом.")
    except Exception as e:
        print(f"Произошла непредвиденная ошибка: {e}")

if __name__ == "__main__":
    main()
